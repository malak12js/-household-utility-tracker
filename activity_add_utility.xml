<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/typeSelector"
            android:text="Select Utility Type"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="#1F1F1F"
            android:padding="15dp"
            android:layout_marginBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/dateSelector"
            android:text="Select Date"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="#1F1F1F"
            android:padding="15dp"
            android:layout_marginBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/currencySelector"
            android:text="Currency (IQD)"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="#1F1F1F"
            android:padding="15dp"
            android:layout_marginBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/notesInput"
            android:hint="Notes (optional)"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:background="#1F1F1F"
            android:padding="15dp"
            android:layout_marginBottom="25dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- TEAL BUTTON -->
        <Button
            android:id="@+id/addUtilityBtn"
            android:text="Add Utility"
            android:backgroundTint="#008577"
            android:textColor="#FFFFFF"
            android:padding="15dp"
            android:layout_marginBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- DARK TEAL BUTTON -->
        <Button
            android:id="@+id/nextBtn"
            android:text="Next"
            android:backgroundTint="#006B63"
            android:textColor="#FFFFFF"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</ScrollView>
